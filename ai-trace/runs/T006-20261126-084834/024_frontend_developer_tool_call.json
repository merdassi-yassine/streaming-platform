    "path": "frontend/templates/frontend/title.html",
    "content": "{% extends 'frontend/base.html' %}\n\n{% block title %}{{ title_data.title.title }} - StreamingPlatform{% endblock %}\n\n{% block content %}\n<div class=\"card\">\n    <p><a href=\"{% url 'home' %}\">&larr; Retour à l'accueil</a></p>\n    \n    <h2>{{ title_data.title.title }}</h2>\n    <p>\n        <strong>Type :</strong> {{ title_data.title.kind|default:\"film\" }} |\n        <strong>Année :</strong> {{ title_data.title.release_year|default:\"-\" }}\n    </p>\n    <p>\n        <strong>Genres :</strong>\n        {% if title_data.title.genres %}\n            {% for g in title_data.title.genres %}<span class=\"badge\"><a href=\"{% url 'genre_detail' g %}\">{{ g }}</a></span> {% endfor %}\n        {% else %}\n            -\n        {% endif %}\n    </p>\n    <hr style=\"border-color: #333;\">\n    <p>\n        <strong>Vues totales :</strong> {{ title_data.views|default:0 }} |\n        <strong>Note moyenne :</strong> {{ title_data.average_rating|default:\"Aucune\" }} / 5 ({{ title_data.rating_count|default:0 }} avis)\n    </p>\n</div>\n\n<div class=\"card\">\n    <h3>Donner un avis</h3>\n\n    {% if success_msg %}\n    <div class=\"alert-success\">{{ success_msg }}</div>\n    {% endif %}\n\n    {% if error_msg %}\n    <div class=\"alert-error\">{{ error_msg }}</div>\n    {% endif %}\n\n    <form method=\"post\">\n        {% csrf_token %}\n        <div style=\"margin-bottom: 1rem;\">\n            <label for=\"user_id\" style=\"display: block; margin-bottom: 0.3rem;\">Identifiant utilisateur (UUID) :</label>\n            <input type=\"text\" id=\"user_id\" name=\"user_id\" value=\"{{ form_data.user_id|default:'' }}\" required style=\"width: 100%; max-width: 400px;\">\n        </div>\n\n        <div style=\"margin-bottom: 1rem;\">\n            <label for=\"rating\" style=\"display: block; margin-bottom: 0.3rem;\">Note (1 à 5) :</label>\n            <select id=\"rating\" name=\"rating\" required style=\"width: 100%; max-width: 150px;\">\n                <option value=\"\">-- Choisir --</option>\n                <option value=\"5\" {% if form_data.rating == \"5\" %}selected{% endif %}>5 - Excellent</option>\n                <option value=\"4\" {% if form_data.rating == \"4\" %}selected{% endif %}>4 - Très bon</option>\n                <option value=\"3\" {% if form_data.rating == \"3\" %}selected{% endif %}>3 - Moyen</option>\n                <option value=\"2\" {% if form_data.rating == \"2\" %}selected{% endif %}>2 - Décevant</option>\n                <option value=\"1\" {% if form_data.rating == \"1\" %}selected{% endif %}>1 - Mauvais</option>\n            </select>\n        </div>\n\n        <div style=\"margin-bottom: 1rem;\">\n            <label for=\"comment\" style=\"display: block; margin-bottom: 0.3rem;\">Commentaire (optionnel) :</label>\n            <textarea id=\"comment\" name=\"comment\" rows=\"3\" style=\"width: 100%; max-width: 500px; background: #222; color: #fff; border: 1px solid #333; border-radius: 4px; padding: 0.5rem;\">{{ form_data.comment|default:'' }}</textarea>\n        </div>\n\n        <button type=\"submit\">Envoyer l'avis</button>\n    </form>\n</div>\n{% endblock %}\n"
  },
