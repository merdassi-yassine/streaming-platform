+                <option value="5" {% if form_data.rating == "5" %}selected{% endif %}>5 - Excellent</option>
+                <option value="4" {% if form_data.rating == "4" %}selected{% endif %}>4 - Très bon</option>
+                <option value="3" {% if form_data.rating == "3" %}selected{% endif %}>3 - Moyen</option>
+                <option value="2" {% if form_data.rating == "2" %}selected{% endif %}>2 - Décevant</option>
+                <option value="1" {% if form_data.rating == "1" %}selected{% endif %}>1 - Mauvais</option>
+            </select>
+        </div>
+
+        <div style="margin-bottom: 1rem;">
+            <label for="comment" style="display: block; margin-bottom: 0.3rem;">Commentaire (optionnel) :</label>
+            <textarea id="comment" name="comment" rows="3" style="width: 100%; max-width: 500px; background: #222; color: #fff; border: 1px solid #333; border-radius: 4px; padding: 0.5rem;">{{ form_data.comment|default:'' }}</textarea>
+        </div>
+
+        <button type="submit">Envoyer l'avis</button>
+    </form>
+</div>
+{% endblock %}
