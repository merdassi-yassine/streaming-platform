+{% extends 'frontend/base.html' %}
+
+{% block title %}Historique - StreamingPlatform{% endblock %}
+
+{% block content %}
+<div class="card">
+    <h2>Historique de visionnage</h2>
+    <p>Utilisateur : <code>{{ user_id }}</code></p>
+    <p><a href="{% url 'home' %}">&larr; Retour à l'accueil</a></p>
+
+    {% if history %}
+    <table>
+        <thead>
+            <tr>
+                <th>Date / Heure</th>
+                <th>Titre</th>
+                <th>Durée (sec)</th>
+                <th>Terminé</th>
+            </tr>
