+    <p><a href="{% url 'home' %}">&larr; Retour à l'accueil</a></p>
+    
+    <h2>{{ title_data.title.title }}</h2>
+    <p>
+        <strong>Type :</strong> {{ title_data.title.kind|default:"film" }} |
+        <strong>Année :</strong> {{ title_data.title.release_year|default:"-" }}
