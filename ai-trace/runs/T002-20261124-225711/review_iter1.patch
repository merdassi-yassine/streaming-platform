+"""Couche DAO : SEULE couche qui parle à Cassandra.
+
+Chaque DAO reçoit ``session`` et ``keyspace`` au constructeur et prépare
+ses requêtes une seule fois. Les écritures multi-tables non counter d'une
+même entité utilisent un ``BatchStatement`` LOGGED ; les compteurs sont
+toujours exécutés séparément (Cassandra n'autorise pas de mélanger
+compteurs et écritures normales dans un même batch).
+"""
+
+from datetime import date, datetime
+from typing import Dict, List, Optional, Tuple
+from uuid import UUID
+
+from cassandra.query import BatchStatement, ConsistencyLevel
+
+from streaming.models import Title, User
+
+
+class TitleDAO:
+    """Accès aux tables ``title_by_id`` (Q1) et ``titles_by_genre`` (Q2)."""
